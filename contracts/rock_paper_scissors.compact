pragma language_version >= 0.20;

// ============================================================================
// MIDNIGHT COMPACT CONTRACT: ROCK PAPER SCISSORS (ZK DAPP)
// ============================================================================
//
// PRIVACY MODEL:
// ----------------------------------------------------------------------------
// PUBLIC STATE (On-Chain Ledger):
//   - stage: Cell<Uint<8>> (0 = Waiting for Player 1 commitment, 1 = Player 1 Committed, 2 = Finished)
//   - player1_commitment: Cell<Bytes<32>> (Hash of Player 1's secret move + salt)
//   - player2_move: Cell<Uint<8>> (0 = Rock, 1 = Paper, 2 = Scissors)
//   - winner: Cell<Uint<8>> (0 = None / Tie, 1 = Player 1 Wins, 2 = Player 2 Wins)
//
// PRIVATE WITNESS (Off-Chain Circuit Input):
//   - player1_choice: Uint<8> (Player 1's secret move: 0=Rock, 1=Paper, 2=Scissors)
//   - player1_salt: Bytes<32> (Player 1's secret ZK salt)
//
// PROOFS & DISCLOSURE:
//   - Player 1 commits their secret move via ZK witness circuit.
//   - Player 2 plays their move publicly.
//   - Player 1 discloses their choice & salt to resolve game state on ledger.
// ============================================================================

export ledger stage: Uint<8>;
export ledger player1_commitment: Bytes<32>;
export ledger player2_move: Uint<8>;
export ledger winner: Uint<8>;

export circuit commit_p1(commitment: Bytes<32>): [] {
    assert(stage.read() == 0, "Game already in progress or completed");
    player1_commitment.write(disclose(commitment));
    stage.write(disclose(1));
}

export circuit play_p2(choice: Uint<8>): [] {
    assert(stage.read() == 1, "Waiting for Player 1 commitment");
    assert(choice <= 2, "Invalid choice: 0=Rock, 1=Paper, 2=Scissors");
    player2_move.write(disclose(choice));
}

export circuit resolve_game(p1_choice: Uint<8>, salt: Bytes<32>): [] {
    assert(stage.read() == 1, "Game must be in committed state");
    assert(p1_choice <= 2, "Invalid choice: 0=Rock, 1=Paper, 2=Scissors");

    stage.write(disclose(2));

    const p1_rev = disclose(p1_choice);
    const p2_m = player2_move.read();

    if (p1_rev == p2_m) {
        winner.write(disclose(0));
    } else if ((p1_rev == 0 && p2_m == 2) ||
               (p1_rev == 1 && p2_m == 0) ||
               (p1_rev == 2 && p2_m == 1)) {
        winner.write(disclose(1));
    } else {
        winner.write(disclose(2));
    }
}

